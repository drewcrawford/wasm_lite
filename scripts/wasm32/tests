#!/usr/bin/env bash
set -euo pipefail

if [[ " $* " =~ " --relaxed " ]]; then
    export RELAXED_WARNINGS=1
fi
source "$(dirname "$0")/_env"
cd "$REPO_ROOT"

CARGO_ARGS=()
for arg in "$@"; do
    if [[ "$arg" != "--relaxed" ]]; then
        CARGO_ARGS+=("$arg")
    fi
done

cargo build -p wasm_lite_cli

# The standard Rust-stable build has no shared memory or atomics. Exercise its
# event-loop executor and local host timer separately from the nightly threaded
# suite below, so an accidental atomic-wait dependency cannot hide in CI.
echo "testing wasm_lite_std stable non-atomic timer (firefox)"
RUSTFLAGS="$WASM32_RUSTFLAGS" \
RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" \
CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
cargo +stable test -p wasm_lite_std --test browser \
    --target wasm32-unknown-unknown sleep_async_waits_on_the_main_thread

echo "testing examples/tests-demo passing suite"
(cd examples/tests-demo && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --test passing)

echo "testing examples/tests-demo binding kinds"
(cd examples/tests-demo && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --test bindings)

# A wasm-bindgen interop module in *test* mode: the runner has to build the
# interop bundle and drive tests through it, which only works because the
# wasm-bindgen CLI preserves our custom sections and __wl_test_* exports.
echo "testing examples/interop harness (wasm-bindgen interop, test mode)"
(cd examples/interop && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --test harness)

# The same module under atomics. This combination is its own stage because the
# wasm-bindgen CLI runs a threading transform that the plain interop build never
# reaches, and that transform needs two exports the generated glue does not read
# (__tls_base, __tls_align). Pruning the export list to what the glue reads
# passed every native threaded test and broke every interop build; nothing here
# covered the overlap until this stage existed.
echo "testing examples/interop harness under atomics (wasm-bindgen threading transform)"
(cd examples/interop && RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" cargo +nightly test --target wasm32-unknown-unknown -Z build-std=std,panic_abort --test harness)

echo "testing examples/tests-demo closures"
(cd examples/tests-demo && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --test closures)

# Nightly + atomics because the async benchmark uses wasm_lite_std, which needs
# shared memory. Unmeasured: a timing taken while the rest of the suite competes
# for the same cores is worse than none, because it looks like data.
echo "running examples/bench-demo benchmarks (unmeasured: CI timings are noise)"
(cd examples/bench-demo && RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" cargo +nightly test --target wasm32-unknown-unknown -Z build-std=std,panic_abort --benches)

echo "testing backend-wasm-lite/consumer-demo (depends only on the shim)"
(cd backend-wasm-lite/consumer-demo && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --test bindings)

echo "testing backend-wasm-lite/consumer-demo wasm-bindgen-test harness"
(cd backend-wasm-lite/consumer-demo && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --test wbt_harness)

echo "testing backend-wasm-lite/consumer-async (async tests, atomics)"
(cd backend-wasm-lite/consumer-async && RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" cargo +nightly test --target wasm32-unknown-unknown -Z build-std=std,panic_abort --test async_harness)

echo "testing examples/doctest-demo doctests"
(cd examples/doctest-demo && RUSTFLAGS="$WASM32_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_RUSTDOCFLAGS" cargo test --target wasm32-unknown-unknown --doc)

# wasm_lite_std's doctests are the only place several threading and async APIs
# are exercised the way a user would write them -- worker_doctest!,
# async_doctest!, the blocking lock/condvar handshakes. `cargo doc` builds those
# examples but never runs them, so before this stage a doctest that failed in the
# browser was indistinguishable from a passing build. Atomics, hence nightly +
# build-std.
echo "testing wasm_lite_std doctests (atomics, firefox)"
RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    cargo +nightly test -p wasm_lite_std --doc \
    --target wasm32-unknown-unknown -Z build-std=std,panic_abort

# The crate's own lib tests, which until 2026-08-03 did not compile for wasm32
# at all -- they used #[test_executors::async_test], whose published expansion is
# #[wasm_bindgen_test]. They now use wasm_lite's macros directly, so the unit
# tests for condvar, mutex, rwlock, mpsc and spinlock run in a browser rather
# than natively only.
echo "testing wasm_lite_std lib tests (firefox, then chrome)"
for BROWSER in firefox chrome; do
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    WASM_LITE_BROWSER="$BROWSER" \
    cargo +nightly test -p wasm_lite_std --lib \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort
done

# `wasm_lite::fetch`, in both browsers — they disagree about whether a HEAD
# response's body is null or an empty stream, and a Firefox-only run was green
# on an assertion Chrome rejects.
echo "testing wasm_lite::fetch browser suite (firefox, then chrome)"
for BROWSER in firefox chrome; do
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    WASM_LITE_BROWSER="$BROWSER" \
    cargo +nightly test -p wasm_lite_std --test fetch \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort
done

# `wasm_lite::websocket`, against the runner's own echo endpoint.
echo "testing wasm_lite::websocket browser suite (firefox, then chrome)"
for BROWSER in firefox chrome; do
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    WASM_LITE_BROWSER="$BROWSER" \
    cargo +nightly test -p wasm_lite_std --test websocket \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort
done

# `wasm_lite::dom`, against the test page itself.
echo "testing wasm_lite::dom browser suite (firefox, then chrome)"
for BROWSER in firefox chrome; do
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    WASM_LITE_BROWSER="$BROWSER" \
    cargo +nightly test -p wasm_lite_std --test dom \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort
done

echo "testing wasm_lite_std browser suite"
if ((${#CARGO_ARGS[@]})); then
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    cargo +nightly test -p wasm_lite_std --test browser \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort "${CARGO_ARGS[@]}"
else
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    cargo +nightly test -p wasm_lite_std --test browser \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort
fi

# ...and again in Chrome. Not redundancy: browsers differ on exactly the things
# this suite covers, and a Firefox-only run stayed green for months while
# Chrome deadlocked on a worker spawning a worker (a nested worker's module
# script is fetched through its parent, and a parent in `Atomics.wait` never
# services it). Threading is where that difference bites, so this is the one
# suite worth paying for twice.
#
# WASM_LITE_GPU gives headless Chrome a software adapter; harmless here, and it
# keeps this invocation usable for graphics suites later.
echo "testing wasm_lite_std browser suite (chrome)"
if ((${#CARGO_ARGS[@]})); then
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    WASM_LITE_BROWSER=chrome WASM_LITE_GPU=1 \
    cargo +nightly test -p wasm_lite_std --test browser \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort "${CARGO_ARGS[@]}"
else
    RUSTFLAGS="$WASM32_ATOMICS_RUSTFLAGS" \
    RUSTDOCFLAGS="$WASM32_ATOMICS_RUSTDOCFLAGS" \
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER="$CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER" \
    WASM_LITE_BROWSER=chrome WASM_LITE_GPU=1 \
    cargo +nightly test -p wasm_lite_std --test browser \
        --target wasm32-unknown-unknown -Z build-std=std,panic_abort
fi
