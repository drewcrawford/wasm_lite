#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

WARN_FLAGS="-D warnings"
if [[ " $* " =~ " --relaxed " ]]; then
    WARN_FLAGS=""
fi

RUSTFLAGS="$WARN_FLAGS" cargo check --workspace

# The fake-wasm-bindgen shim is its own workspace (it reuses the `wasm-bindgen`
# package name), so it needs its own invocation.
RUSTFLAGS="$WARN_FLAGS" cargo check --manifest-path backend-wasm-lite/Cargo.toml --workspace
