#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

WARN_FLAGS="-D warnings"
if [[ " $* " =~ " --relaxed " ]]; then
    WARN_FLAGS=""
fi

RUSTFLAGS="$WARN_FLAGS" cargo clippy --workspace --all-targets
RUSTFLAGS="$WARN_FLAGS" cargo clippy -p wasm_lite --all-targets --features diagnostics
RUSTFLAGS="$WARN_FLAGS" cargo clippy -p wasm_lite_std --all-targets --features diagnostics
RUSTFLAGS="$WARN_FLAGS" cargo clippy -p wasm_lite_std --all-targets --features fs

# Its own workspace, and the one example meant to build for the host, so
# `--workspace` above does not reach it and the wasm32 scripts would otherwise be
# the only thing linting it.
(cd examples/dual-demo && RUSTFLAGS="$WARN_FLAGS" cargo clippy --all-targets)
