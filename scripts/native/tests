#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../.."

WARN_FLAGS="-D warnings"
if [[ " $* " =~ " --relaxed " ]]; then
    WARN_FLAGS=""
fi

RUSTFLAGS="$WARN_FLAGS" RUSTDOCFLAGS="$WARN_FLAGS" cargo test --workspace --lib --bins --tests
RUSTFLAGS="$WARN_FLAGS" RUSTDOCFLAGS="$WARN_FLAGS" cargo test -p wasm_lite_std --features fs --lib --tests
RUSTFLAGS="$WARN_FLAGS" RUSTDOCFLAGS="$WARN_FLAGS" cargo test -p wasm_lite_std --features fs --doc

# Each example is its own workspace, so the line above does not reach them. This
# one has to run *here* rather than only under wasm32: it is the proof that
# `#[wasm_lite_test]` registers with libtest off wasm32, and a suite that only
# ever ran in a browser could not show that. `scripts/wasm32/tests` runs the
# same file the other way.
echo "testing examples/dual-demo (native)"
(cd examples/dual-demo && RUSTFLAGS="$WARN_FLAGS" RUSTDOCFLAGS="$WARN_FLAGS" cargo test)
